# Copy to `.env` (gitignored). Single source of truth for web, api, and Docker Compose.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Postgres
POSTGRES_DB=buena
POSTGRES_USER=buena
POSTGRES_PASSWORD=buena
POSTGRES_PORT=55432
DATABASE_URL=postgres://buena:buena@localhost:55432/buena
# Inside Docker Compose: postgres://buena:buena@db:5432/buena
# Host port is 55432 to avoid clashing with a host-installed Postgres on 5432.

# Ports
API_PORT=3001
WEB_PORT=3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=de
NEXT_PUBLIC_ENABLE_AI=true

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:3000

# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
EXTRACTION_MAX_TOKENS=25000
EXTRACTION_PROMPT_VERSION=extract.v1
CHAT_MODEL=gpt-4o-mini
CHAT_MAX_TURNS=10

# Rate limits (per minute)
RATE_LIMIT_EXTRACTION_PER_MIN=5
RATE_LIMIT_CHAT_PER_MIN=30

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# Tenancy
TENANT_DEFAULT_ID=demo

# Observability (optional)
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
