# Copy to `.env` (gitignored). Single source of truth for web, api, and Docker Compose.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Postgres
POSTGRES_DB=buena
POSTGRES_USER=buena
POSTGRES_PASSWORD=buena
POSTGRES_PORT=55432
DATABASE_URL=postgres://buena:buena@localhost:55432/buena
# Inside Docker Compose: postgres://buena:buena@db:5432/buena
# Host port is 55432 to avoid clashing with a host-installed Postgres on 5432.

# Ports
API_PORT=3001
WEB_PORT=3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:3000

# AI provider — set at least one key. AI_PROVIDER pins the choice when
# both keys are present; unset, the runtime picks Anthropic when its
# key is set, otherwise OpenAI. Selection is at boot — no runtime
# cross-provider fallback.
AI_PROVIDER=anthropic

# Anthropic Claude (default)
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=60000
ANTHROPIC_MAX_OUTPUT_TOKENS=4096

# OpenAI (swappable alternative — uncomment OPENAI_API_KEY to enable)
# OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000

EXTRACTION_MAX_TOKENS=25000
EXTRACTION_PROMPT_VERSION=extract.v1

# Rate limits (per minute, per IP)
RATE_LIMIT_EXTRACTION_PER_MIN=5
RATE_LIMIT_UPLOAD_PER_MIN=10

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# Tenancy
TENANT_DEFAULT_ID=demo
